# Copy to .env and fill in. NEVER commit .env.
# Blockchain (leave empty for offline demo mode: verdicts only)
RPC_URL=https://rpc-amoy.polygon.technology
VERIFIER_PRIVATE_KEY=0xYOUR_VERIFIER_TEST_WALLET_KEY
DEPLOY_BLOCK=0
# Plain-language explanation (optional; a template is used without it)
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant
# Website address(es) allowed to call the API, comma separated
ALLOWED_ORIGINS=http://localhost:5173
